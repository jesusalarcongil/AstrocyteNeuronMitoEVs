   "source": [
    "1. Introduce variables"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0951711b-660d-4cf7-aacb-cfd82b990b32",
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess\n",
    "import os\n",
    "import re\n",
    "import shutil\n",
    "import tifffile as tiff\n",
    "from tifffile import imread, imwrite, imsave\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import igraph as ig\n",
    "from tqdm.notebook import trange\n",
    "import tifffile\n",
    "from skimage import io, filters, morphology, measure\n",
    "from skimage.filters import threshold_otsu, sobel\n",
    "from scipy.ndimage import binary_dilation, binary_closing, binary_fill_holes, gaussian_filter, binary_erosion, generate_binary_structure\n",
    "import mitotnt\n",
    "import gc\n",
    "\n",
    "RawNd2Path = \"/home/jesusalarcon/Analysis/RawNd2Data\"\n",
    "NChannels = 1\n",
    "TimeFrameInterval = 2   \n",
    "LateralPixelSize = 111\n",
    "ZDistance = 200\n",
    "PSFZslices = 21\n",
    "NumAperture = 1.42\n",
    "RefractIndex = 1.515\n",
    "NCores = 15\n",
    "NIter = 20\n",
    "MitoChannel = 583\n",
    "\n",
    "#TresholdMG = 1000
   ]
  },
  {
   "cell_type": "markdown",
   "id": "99420631-579c-4283-8e8e-76c75b337036",
   "metadata": {},
   "source": [
    "2. Convert nd2 to tiff"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "93cc07d0-7046-4b44-a0b5-83a5e59640ba",
   "metadata": {},
   "source": [
    "2.1. Crear la carpeta de conversion a tiff"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f8fa75db-4c36-4c46-acba-df81ad3016cf",
   "metadata": {},
   "outputs": [],
   "source": [
    "RawNd2PathIndex =RawNd2Path.rfind('/')\n",
    "RawTiffData = RawNd2Path[:(RawNd2PathIndex+1)] + \"RawTiffData\"\n",
    "#os.makedirs(RawTiffData)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4f107039-90b2-48a4-8ee6-08824445a0a7",
   "metadata": {},
   "source": [
    "2.2 Crear la lista de las path de los archivos input y de los archivos output de nd2 a tiff"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "f18f8841-3385-42ba-b7b8-5d2a0b358ba9",
   "metadata": {},
   "outputs": [],
   "source": [
    "RawNd2Files = os.listdir(RawNd2Path)\n",
    "RawNd2FilePaths = []\n",
    "\n",
    "for i in range(len(RawNd2Files)):\n",
    "    NameFileIndex = RawNd2Files[i].rfind('.')\n",
    "    NameFile = RawNd2Files[i][:NameFileIndex]\n",
    "    RawTiffFilePath = RawTiffData + \"/\" + str(NameFile)\n",
    "    os.makedirs(RawTiffFilePath)\n",
    "    RawNd2FilePath = RawNd2Path + \"/\" + str(RawNd2Files[i])\n",
    "    RawNd2FilePaths.append(RawNd2FilePath)\n",
    "\n",
    "RawTiffFiles = []\n",
    "\n",
    "for file in RawNd2Files:\n",
    "    TiffFile = file.replace(\".nd2\", \"_T%t.tif\")\n",
    "    RawTiffFiles.append(TiffFile)\n",
    "\n",
    "RawTiffFilePaths = []\n",
    "RawTiffFolders = os.listdir(RawTiffData)\n",
    "\n",
    "for i in range(len(RawTiffFiles)):\n",
    "    for z in range(len(RawTiffFolders)):\n",
    "        SameFileFolder = re.search(RawTiffFolders[z], RawTiffFiles[i])\n",
    "        if SameFileFolder != None:\n",
    "            RawTiffFilePath = RawTiffData + \"/\" + str(RawTiffFolders[z]) + \"/\" + str(RawTiffFiles[i])\n",
    "            RawTiffFilePaths.append(RawTiffFilePath)"
   ]
  },
