  {
   "cell_type": "markdown",
   "id": "30ed7cbe-5b7a-43fa-b083-cb94060f00a6",
   "metadata": {},
   "source": [
    "3.4 Move the log files to another folder"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "3534ddcc-9279-4f55-b9c7-c5d5ea473682",
   "metadata": {},
   "outputs": [],
   "source": [
    "LogFile = '.log.txt'\n",
    "DeconLogFolder = RawNd2Path[:(RawNd2PathIndex+1)] + \"/\" + \"DeconLog\"\n",
    "os.makedirs(DeconLogFolder)\n",
    "\n",
    "DeconTiffInputFolder = os.listdir(DeconTiffData)\n",
    "\n",
    "for y in range(len(DeconTiffInputFolder)):\n",
    "    DeconTiffInputFiles = os.listdir(DeconTiffData + \"/\" + DeconTiffInputFolder[y])\n",
    "    DeconTiffFolder = DeconTiffData + \"/\" + DeconTiffInputFolder[y] + \"/\" + str(MitoChannel)\n",
    "    DeconTiffFiles = os.listdir(DeconTiffFolder)\n",
    "    for x in range(len(DeconTiffFiles)):\n",
    "        DeconLogFile = re.search(LogFile, DeconTiffFiles[x])\n",
    "        if DeconLogFile != None:\n",
    "            DeconLogPath = DeconTiffFolder + \"/\" + DeconTiffFiles[x]\n",
    "            DeconLogFolderPath = DeconLogFolder + \"/\" + DeconTiffFiles[x]\n",
    "            shutil.move(DeconLogPath, DeconLogFolder)"
   ]
  },
