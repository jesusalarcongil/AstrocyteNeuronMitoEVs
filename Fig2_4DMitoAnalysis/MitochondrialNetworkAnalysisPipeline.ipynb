   "source": [
    "MitoGraphFolder = RawNd2Path[:(RawNd2PathIndex+1)] + \"MitoGraphData\"\n",
    "MitoGraphFolderSamples = os.listdir(MitoGraphFolder)\n",
    "xysize = LateralPixelSize/1000\n",
    "zsize = ZDistance/1000\n",
    "mitopattern = \"frame\"    \n",
    "\n",
    "for x in range(len(MitoGraphFolderSamples)):\n",
