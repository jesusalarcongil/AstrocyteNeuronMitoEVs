   "source": [
    "3. Deconvolution with Deconwolf"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "659492ec-4374-42b5-81c3-b866a82579b3",
   "metadata": {},
   "source": [
    "3.1. Crear la carpeta y las carpetas de deconvolution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "25e49e51-b4e1-40b7-a18a-84cb735870b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "RawNd2PathIndex = RawNd2Path.rfind('/')\n",
    "DeconTiffData = RawNd2Path[:(RawNd2PathIndex+1)] + \"DeconTiffData\"\n",
    "os.makedirs(DeconTiffData)\n",
    "\n",
    "EmWavesDeconTiffPaths = []\n",
    "\n",
    "for i in range(len(RawNd2Files)):\n",
    "    NameFileIndex = RawNd2Files[i].rfind('.')\n",
    "    NameFile = RawNd2Files[i][:NameFileIndex]\n",
    "    DeconTiffFilePath = DeconTiffData + \"/\" + str(NameFile)\n",
    "    os.makedirs(DeconTiffFilePath)\n",
    "    DeconTiffChannelData = DeconTiffFilePath + \"/\" + str(MitoChannel)\n",
    "    os.makedirs(DeconTiffChannelData)\n",
    "    EmWavesDeconTiffPaths.append(DeconTiffChannelData)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "67410f1a-4aae-42f4-8170-09e04533a4dc",
   "metadata": {},
   "source": [
    "3.2 Crear los archivos PSF de los canales"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "55b8521c-b060-4f05-96cf-e02cd7ffdd83",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Writing '/home/jesusalarcon/Analysis/PSFData/583PSF.tiff' (32-bit float)\n"
     ]
    }
   ],
   "source": [
    "PSFData = RawNd2Path[:(RawNd2PathIndex+1)] + \"PSFData\"\n",
    "os.makedirs(PSFData)\n",
    "RawTiffInputFolder = os.listdir(RawTiffData)\n",
    "\n",
    "for channel in range(NChannels):\n",
    "    PSFFile = PSFData + \"/\" + str(MitoChannel) + \"PSF.tiff\"\n",
    "    createPSF = [\"dw_bw\", \"--resxy\", str(LateralPixelSize), \"--resz\", str(ZDistance), \"--lambda\", str(MitoChannel), \"--NA\", \n",
    "                                                                                                  str(NumAperture), \"--ni\",\n",
    "                                                                                                  str(RefractIndex), \"--nslice\",\n",
    "                                                                                                  str(PSFZslices), PSFFile]\n",
    "    subprocess.run(createPSF)"
   ]
  },
